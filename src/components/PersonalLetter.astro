---
interface Props {
  text: string;
}

const { text } = Astro.props;
const paragraphs = text.split('\n\n').filter(Boolean);
const opening = paragraphs[0] ?? '';
const body     = paragraphs.slice(1, -1); // drop opening and closing ("Met liefde,")
---

<section id="brief" class="bg-wedding-bg" style="padding-top:clamp(28px,5vw,56px);padding-bottom:clamp(28px,5vw,56px);">
  <div style="max-width:600px; margin:0 auto; padding:0 1.5rem; text-align:center;">

    <!-- Couple photo -->
    <div data-reveal class="flex justify-center mb-3">
      <img
        src="/images/couple.jpeg"
        alt="Sebastiaan & Esmeralda"
        class="w-[110px] h-[110px] md:w-[140px] md:h-[140px] rounded-full object-cover"
        style="border:3px solid rgba(255,255,255,0.2); box-shadow:0 8px 40px rgba(0,0,0,0.35);"
      />
    </div>

    <!-- Vertical connector line -->
    <div class="flex justify-center mb-3">
      <div style="width:1px;height:24px;background:rgba(255,255,255,0.15);"></div>
    </div>

    <!-- Opening salutation -->
    <p
      data-reveal
      data-reveal-delay="1"
      class="font-display"
      style="font-size:1.3rem;font-style:italic;font-weight:400;color:rgba(255,255,255,0.9);margin-bottom:1rem;line-height:1.4;"
    >
      {opening}
    </p>

    <!-- Body paragraphs -->
    <div data-reveal data-reveal-delay="2" class="letter-body">
      {body.map((para) => (
        <p>{para}</p>
      ))}
    </div>

    <!-- Closing -->
    <p
      data-reveal
      data-reveal-delay="3"
      class="font-display"
      style="margin-top:1rem;font-size:1.1rem;font-weight:400;color:rgba(255,255,255,0.85);line-height:1.6;"
    >
      Liefs,<br />
      <span style="font-weight:600;">Sebastiaan &amp; Esmeralda</span>
    </p>

  </div>
</section>

<style>
  .letter-body {
    max-width: 34rem;
    margin: 0 auto;
    text-wrap: pretty;
    font-weight: 400;
    font-size: clamp(1.0625rem, 0.98rem + 0.4vw, 1.125rem);
    line-height: 1.72;
    color: rgba(255, 255, 255, 0.88);
  }

  .letter-body p + p {
    margin-top: 1.15em;
  }

  /* Op smalle schermen levert minder zijmarge een bruikbaardere regellengte op. */
  @media (max-width: 480px) {
    .letter-body {
      margin-inline: -0.5rem;
    }
  }
</style>
