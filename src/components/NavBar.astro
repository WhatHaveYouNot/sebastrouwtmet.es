---
interface Props {
  variant: 'weekend' | 'dag' | 'avond';
}

const { variant } = Astro.props;

const navItems = [
  { label: 'Brief',       id: 'brief' },
  { label: 'FAQ',         id: 'faq' },
  { label: 'Programma',   id: 'programma' },
  ...(variant === 'weekend' ? [{ label: 'Plattegrond', id: 'plattegrond' }] : []),
  { label: 'Verzoekje',   id: 'verzoekje' },
  { label: 'MC',          id: 'ceremoniemeester' },
  { label: 'Acts',        id: 'acts' },
  { label: 'Cadeau',      id: 'cadeau' },
  { label: 'Locatie',     id: 'locatie' },
];
---

<nav
  id="site-nav"
  aria-label="Sectienavigatie"
  style="position:fixed;top:0;left:0;right:0;z-index:200;height:48px;background:rgba(20,0,8,0.88);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-bottom:1px solid rgba(255,255,255,0.1);box-shadow:0 4px 20px rgba(0,0,0,0.3);transform:translateY(-100%);transition:transform 0.3s cubic-bezier(0.22,1,0.36,1);will-change:transform;"
>
  <div id="nav-inner">
    <div id="nav-links-wrapper">
      {navItems.map((item, i) => (
        <>
          <a href={`#${item.id}`} class="nav-link" data-nav={item.id}>
            {item.label}
          </a>
          {i < navItems.length - 1 && (
            <span class="nav-sep" aria-hidden="true">|</span>
          )}
        </>
      ))}
    </div>
  </div>
</nav>

<script>
  // Randvervaging volgt de werkelijke scrollpositie, zodat hij alleen verschijnt
  // waar daadwerkelijk nog inhoud buiten beeld valt.
  const scroller = document.getElementById('nav-inner');

  if (scroller) {
    const updateFades = () => {
      const max = scroller.scrollWidth - scroller.clientWidth;
      scroller.style.setProperty('--fade-start', scroller.scrollLeft > 4 ? '1.25rem' : '0px');
      scroller.style.setProperty('--fade-end', scroller.scrollLeft < max - 4 ? '1.25rem' : '0px');
    };

    scroller.addEventListener('scroll', updateFades, { passive: true });
    window.addEventListener('resize', updateFades);
    updateFades();
  }
</script>

<style is:global>
  #nav-inner {
    height: 100%;
    display: flex;
    align-items: center;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    --fade-start: 0px;
    --fade-end: 1.25rem;
    mask-image: linear-gradient(to right, transparent 0, black var(--fade-start),
      black calc(100% - var(--fade-end)), transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0, black var(--fade-start),
      black calc(100% - var(--fade-end)), transparent 100%);
  }

  #nav-inner::-webkit-scrollbar { display: none; }

  /* Auto-marges centreren de rij wél, maar vallen terug op 0 zodra de inhoud
     breder is dan de balk. Met justify-content:center belandt het eerste item
     buiten de scroll-oorsprong en is het onbereikbaar. */
  #nav-links-wrapper {
    display: flex;
    align-items: center;
    white-space: nowrap;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    min-width: 44px;
    padding: 0 10px;
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.48);
    text-decoration: none;
    transition: color 0.2s ease;
    white-space: nowrap;
    font-family: inherit;
  }

  .nav-sep {
    color: rgba(255, 255, 255, 0.18);
    font-size: 0.55rem;
    flex-shrink: 0;
    user-select: none;
  }

  .nav-link:hover {
    color: rgba(255, 255, 255, 0.8) !important;
  }

  .nav-link.nav-link--active {
    color: rgba(255, 255, 255, 0.95) !important;
    font-weight: 500 !important;
  }

  .nav-link.nav-link--active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 10px;
    right: 10px;
    height: 2px;
    background: rgba(255, 255, 255, 0.6);
    border-radius: 1px;
  }

  /* Smalle schermen: minder zijmarge en strakkere letterafstand winnen breedte
     terug, zodat er zo min mogelijk buiten beeld valt. */
  @media (max-width: 639px) {
    #nav-links-wrapper {
      padding-inline: 0.5rem;
    }

    .nav-link {
      font-size: 0.7rem !important;
      padding: 0 6px !important;
      letter-spacing: 0.05em !important;
    }

    .nav-sep {
      font-size: 0.5rem;
    }

    .nav-link.nav-link--active::after {
      left: 6px;
      right: 6px;
    }
  }
</style>

