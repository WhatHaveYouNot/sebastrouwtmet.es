---
interface Props {
  title: string;
  text: string;
  button_text: string;
  url: string;
}

const { title, text, button_text, url } = Astro.props;
---

<section id="verzoekje" class="section-padding bg-wedding-bg">
  <div class="content-width">
    <div
      data-reveal
      class="liquid-glass relative px-8 py-16 md:px-14 md:py-20 text-center overflow-hidden"
    >
      <p class="relative text-[13px] uppercase tracking-[0.3em] text-wedding-accent font-body mb-4">Verzoeknummer</p>
      <h2
        data-reveal
        data-reveal-delay="1"
        class="relative font-display text-3xl md:text-4xl text-wedding-text mb-6"
        style="font-weight: 600;"
      >
        {title}
      </h2>
      <p
        data-reveal
        data-reveal-delay="2"
        class="relative text-wedding-muted max-w-prose mx-auto leading-relaxed mb-10"
        style="font-weight: 400;"
      >
        {text}
      </p>

      <a
        data-reveal
        data-reveal-delay="3"
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="song-btn relative inline-block font-body text-sm uppercase tracking-[0.2em] px-8 py-4 md:px-12"
        style="font-weight: 500;"
      >
        {button_text}
      </a>
    </div>
  </div>
</section>

<style>
  .song-btn {
    background: #FF6600;
    color: #000000;
    border-radius: 50px;
    border: none;
    text-decoration: none;
    box-shadow: 0 4px 24px rgba(255, 102, 0, 0.45);
    transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .song-btn:hover {
    background: #FF7A1F;
    transform: translateY(-2px);
    box-shadow: 0 8px 36px rgba(255, 102, 0, 0.6);
  }
</style>
