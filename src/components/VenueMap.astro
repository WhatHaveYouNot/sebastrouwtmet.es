---
interface Props {
  title: string;
  image: string;
  preview: string;
  image_alt: string;
}

const { title, image, preview, image_alt } = Astro.props;
---

<section id="plattegrond" class="section-padding bg-wedding-bg">
  <div class="content-width text-center">
    <p data-reveal class="text-[13px] uppercase tracking-[0.3em] text-wedding-accent font-body mb-4">
      Plattegrond
    </p>
    <h2
      data-reveal
      data-reveal-delay="1"
      class="font-display text-3xl md:text-4xl text-wedding-text mb-10"
      style="font-weight: 600;"
    >
      {title}
    </h2>

    <div data-reveal data-reveal-delay="2">
      <button
        id="venue-map-open"
        type="button"
        class="venue-map-thumb block mx-auto rounded-2xl overflow-hidden"
        aria-label={`${image_alt} — vergroot bekijken`}
      >
        <img src={preview || image} alt={image_alt} loading="lazy" />
      </button>
    </div>
  </div>
</section>

<dialog id="venue-map-dialog" class="venue-map-dialog" aria-label={image_alt}>
  <button id="venue-map-close" type="button" class="venue-map-close" aria-label="Sluiten">×</button>
  <div id="venue-map-scroller" class="venue-map-scroller">
    <img id="venue-map-full" src={image} alt={image_alt} loading="lazy" />
  </div>
</dialog>

<style>
  .venue-map-thumb {
    max-width: 820px;
    width: 100%;
    padding: 0;
    cursor: pointer;
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.15);
    transition: box-shadow 0.4s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .venue-map-thumb img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), filter 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .venue-map-thumb:hover,
  .venue-map-thumb:focus-visible {
    box-shadow: 0 20px 64px rgba(0, 0, 0, 0.55);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .venue-map-thumb:hover img,
  .venue-map-thumb:focus-visible img {
    transform: scale(1.04);
    filter: brightness(1.06);
  }

  .venue-map-dialog {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(20, 0, 8, 0.96);
  }

  .venue-map-dialog::backdrop {
    background: rgba(20, 0, 8, 0.96);
  }

  .venue-map-scroller {
    width: 100%;
    height: 100%;
    overflow: auto;
    display: flex;
    -webkit-overflow-scrolling: touch;
  }

  /* Standaard past de kaart in beeld; een tik zoomt in naar ware grootte. */
  .venue-map-scroller img {
    margin: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    cursor: zoom-in;
  }

  .venue-map-scroller.is-zoomed img {
    max-width: none;
    max-height: none;
    width: 1172px;
    flex-shrink: 0;
    cursor: zoom-out;
  }

  .venue-map-close {
    position: fixed;
    top: 12px;
    right: 12px;
    z-index: 1;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #ffffff;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }
</style>

<script>
  const dialog = document.getElementById('venue-map-dialog') as HTMLDialogElement | null;
  const openBtn = document.getElementById('venue-map-open');
  const closeBtn = document.getElementById('venue-map-close');
  const scroller = document.getElementById('venue-map-scroller');
  const fullImg = document.getElementById('venue-map-full');

  if (dialog && openBtn && closeBtn && scroller && fullImg) {
    openBtn.addEventListener('click', () => {
      scroller.classList.remove('is-zoomed');
      dialog.showModal();
    });

    closeBtn.addEventListener('click', () => dialog.close());

    fullImg.addEventListener('click', (e) => {
      e.stopPropagation();
      scroller.classList.toggle('is-zoomed');
    });

    // Klik naast de kaart sluit de weergave.
    scroller.addEventListener('click', () => dialog.close());
  }
</script>
